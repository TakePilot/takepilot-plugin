        "matcher": "^mcp__(plugin_takepilot_takepilot|claude_ai_[Tt]ake[Pp]ilot[A-Za-z0-9_]*)__(check_plateau|complete_local_render_upload|estimate|get_account|get_ad_results|get_avatar_checks|get_avatar_setup_link|get_build_check|get_collected_video|get_company_avatar|get_competitor|get_file|get_finish_check|get_gallery_post|get_job|get_local_render_media|get_material|get_picked|get_playbook|get_product|get_product_document|get_product_dossier|get_product_readings|get_publish_link|get_reference|get_referral_summary|list_referral_referred|get_render_frames|get_review_comments|get_segment_job|get_sns_account|get_sns_post|get_source|get_source_transcript|get_stock_image|get_stock_model|get_template|get_video_bundle|get_video_compose|list_avatars|list_batch_clips|list_catalog|list_collected_videos|list_competitors|list_file_models|list_file_parts|list_files|list_finished_videos|list_gallery_posts|list_jobs|list_product_documents|list_product_dossier_revisions|list_product_files|list_products|list_reviews|list_sns_account_stats|list_sns_accounts|list_sns_post_stats|list_sns_posts|list_sources|list_stock_audio|list_stock_models|list_stock_videos|list_templates|list_voices|plan_map_scene|request_local_render_upload|resolve_link|search_places|use_asset|wait_jobs)$",
        "hooks": [
