          }
        ]
      },
      {
        "matcher": "^(Bash|Skill|mcp__(plugin_takepilot_takepilot|claude_ai_[Tt]ake[Pp]ilot[A-Za-z0-9_]*)__(complete_file_upload|request_file_upload))$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/allow-steps.sh\""
          }
        ]
      }
    ]
  }
}
